{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json",
        "webpack": true
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "catalog-service": {
      "type": "application",
      "root": "apps/catalog-service",
      "entryFile": "main",
      "sourceRoot": "apps/catalog-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/catalog-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "recipe-service": {
      "type": "application",
      "root": "apps/recipe-service",
      "entryFile": "main",
      "sourceRoot": "apps/recipe-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/recipe-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "recommendation-service": {
      "type": "application",
      "root": "apps/recommendation-service",
      "entryFile": "main",
      "sourceRoot": "apps/recommendation-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/recommendation-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "interaction-service": {
      "type": "application",
      "root": "apps/interaction-service",
      "entryFile": "main",
      "sourceRoot": "apps/interaction-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/interaction-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "planner-service": {
      "type": "application",
      "root": "apps/planner-service",
      "entryFile": "main",
      "sourceRoot": "apps/planner-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/planner-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "media-service": {
      "type": "application",
      "root": "apps/media-service",
      "entryFile": "main",
      "sourceRoot": "apps/media-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/media-service/tsconfig.app.json",
        "webpack": true
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "auth-lib": {
      "type": "library",
      "root": "libs/auth-lib",
      "entryFile": "index",
      "sourceRoot": "libs/auth-lib/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth-lib/tsconfig.lib.json"
      }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": {
        "tsConfigPath": "libs/messaging/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    }
  }
}
